@model RaceDay.Web.Models.EventRequestDto
@{
    ViewData["Title"] = "Create event";
}

<h1 class="h3 mb-3">Create event</h1>

<form asp-action="CreateEvent" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <partial name="_EventFields" model="Model" />

    <button type="submit" class="btn btn-primary">Create event</button>
    <a asp-action="Events" class="btn btn-outline-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
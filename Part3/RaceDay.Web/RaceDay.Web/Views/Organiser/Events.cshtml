@model List<EventDto>
@{
    ViewData["Title"] = "My events";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">My events</h1>
    <a asp-action="CreateEvent" class="btn btn-primary">Create event</a>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">You have not created any events yet. Click "Create event" to add one.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Event</th>
                    <th>Date</th>
                    <th>Location</th>
                    <th>Type</th>
                    <th class="text-end">Enrolments</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ev in Model)
                {
                    <tr>
                        <td>@ev.Name</td>
                        <td>@ev.EventDate.ToString("dd MMM yyyy HH:mm")</td>
                        <td>@ev.Location</td>
                        <td>@ev.EventType (@ev.DistanceKm km)</td>
                        <td class="text-end">@ev.EnrolmentCount</td>
                        <td class="text-end text-nowrap">
                            <a asp-controller="Categories" asp-action="Index" asp-route-eventId="@ev.EventID"
                               class="btn btn-sm btn-outline-dark">Categories</a>
                            <a asp-controller="EventEnrolments" asp-action="Index" asp-route-eventId="@ev.EventID"
                               class="btn btn-sm btn-outline-dark">Enrolments</a>
                            <a asp-controller="EventResults" asp-action="Index" asp-route-eventId="@ev.EventID"
                               class="btn btn-sm btn-outline-dark">Results</a>
                            <a asp-action="EditEvent" asp-route-id="@ev.EventID"
                               class="btn btn-sm btn-outline-primary">Edit</a>
                            <form asp-action="DeleteEvent" asp-route-id="@ev.EventID" method="post"
                                  class="d-inline"
                                  onsubmit="return confirm('Delete this event? This cannot be undone.');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
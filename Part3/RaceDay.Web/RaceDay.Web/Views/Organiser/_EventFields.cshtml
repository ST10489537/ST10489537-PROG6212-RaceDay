@model RaceDay.Web.Models.EventRequestDto

<div class="mb-3">
    <label asp-for="Name" class="form-label"></label>
    <input asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Description" class="form-label"></label>
    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
    <span asp-validation-for="Description" class="text-danger"></span>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="EventDate" class="form-label"></label>
        <input asp-for="EventDate" class="form-control" type="datetime-local" />
        <span asp-validation-for="EventDate" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="Location" class="form-label"></label>
        <input asp-for="Location" class="form-control" />
        <span asp-validation-for="Location" class="text-danger"></span>
    </div>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="DistanceKm" class="form-label"></label>
        <input asp-for="DistanceKm" class="form-control" type="number" step="0.01" />
        <span asp-validation-for="DistanceKm" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="EventType" class="form-label"></label>
        <select asp-for="EventType" class="form-select"
                asp-items="Html.GetEnumSelectList<RaceDay.Web.Models.EventType>()"></select>
        <span asp-validation-for="EventType" class="text-danger"></span>
    </div>
</div>

<div class="mb-3">
    <label class="form-label">Event banner image (optional)</label>
    @if (!string.IsNullOrWhiteSpace(Model.BannerImageUrl))
    {
        <div class="mb-2">
            <img src="@Model.BannerImageUrl" alt="Current banner" class="rounded" style="max-height:140px;" />
        </div>
    }
    <input type="file" name="bannerFile" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
    <div class="form-text">JPG, PNG or WEBP, up to 5 MB. Choosing a new image replaces the current one.</div>
</div>

@* Keeps the existing banner URL when no new file is chosen. *@
<input asp-for="BannerImageUrl" type="hidden" />
@model EventEnrolmentsViewModel
@{
    ViewData["Title"] = "Enrolments";
}

<a asp-controller="Organiser" asp-action="Events">&larr; Back to my events</a>
<h1 class="h3 mt-2 mb-0">Enrolments</h1>
<p class="text-muted">@Model.Event.Name &middot; @Model.Event.EventDate.ToString("dd MMM yyyy")</p>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

@if (!Model.Enrolments.Any())
{
    <div class="alert alert-info">Nobody has enrolled for this event yet.</div>
}
else
{
    <p>
        <strong>@Model.Enrolments.Count</strong> enrolled:
        @foreach (var group in Model.Enrolments.GroupBy(e => e.CategoryName).OrderBy(g => g.Key))
        {
            <span class="badge bg-dark me-1">@group.Key: @group.Count()</span>
        }
    </p>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Participant</th>
                    <th>Category</th>
                    <th>Enrolled on</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model.Enrolments)
                {
                    <tr>
                        <td>@e.ParticipantName</td>
                        <td>@e.CategoryName</td>
                        <td>@e.EnrolmentDate.ToString("dd MMM yyyy HH:mm")</td>
                        <td><partial name="_StatusBadge" model="e.Status" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
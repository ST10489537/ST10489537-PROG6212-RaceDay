@model EventResultsViewModel
@{
    ViewData["Title"] = "Results";
}

<a asp-controller="Organiser" asp-action="Events">&larr; Back to my events</a>
<h1 class="h3 mt-2 mb-0">Results</h1>
<p class="text-muted">@Model.Event.Name &middot; @Model.Event.EventDate.ToString("dd MMM yyyy")</p>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

@if (Model.Event.EventDate > DateTime.Now)
{
    <div class="alert alert-warning">
        This event has not taken place yet. Results are normally captured after the event concludes.
    </div>
}

@if (!Model.Rows.Any())
{
    <div class="alert alert-info">Nobody is enrolled for this event, so there are no results to capture.</div>
}
else
{
    <p class="text-muted">Enter the finish time as <strong>hh:mm:ss</strong> (for example 03:45:12) and the finishing position.</p>

    <ul class="list-group">
        @foreach (var row in Model.Rows)
        {
            <li class="list-group-item">
                <form asp-action="Save" asp-route-eventId="@Model.Event.EventID" method="post"
                      class="row g-2 align-items-center">
                    <input type="hidden" name="enrolmentId" value="@row.Enrolment.EnrolmentID" />
                    @if (row.Result != null)
                    {
                        <input type="hidden" name="resultId" value="@row.Result.ResultID" />
                    }

                    <div class="col-md-4">
                        <div class="fw-bold">@row.Enrolment.ParticipantName</div>
                        <div class="small text-muted">@row.Enrolment.CategoryName</div>
                    </div>

                    <div class="col-md-3">
                        <input type="text" name="finishTime" class="form-control"
                               placeholder="hh:mm:ss" pattern="\d{2}:\d{2}:\d{2}" required
                               value="@(row.Result != null ? Formatting.FinishTime(row.Result.FinishTime) : "")" />
                    </div>

                    <div class="col-md-3">
                        <input type="number" name="finishPosition" class="form-control"
                               placeholder="Position" min="1" required
                               value="@(row.Result != null ? row.Result.FinishPosition.ToString() : "")" />
                    </div>

                    <div class="col-md-2 d-grid">
                        <button type="submit" class="btn @(row.Result != null ? "btn-outline-primary" : "btn-primary")">
                            @(row.Result != null ? "Update" : "Save")
                        </button>
                    </div>
                </form>
            </li>
        }
    </ul>
}
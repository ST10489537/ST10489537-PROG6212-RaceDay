@model RaceDay.Web.Models.RegisterViewModel
@{
    ViewData["Title"] = "Register";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <h1 class="h3 mb-3">Create your RaceDay account</h1>

        <form asp-action="Register" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="mb-3">
                <label asp-for="FullName" class="form-label"></label>
                <input asp-for="FullName" class="form-control" autocomplete="name" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email address</label>
                <input asp-for="Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PhoneNumber" class="form-label"></label>
                <input asp-for="PhoneNumber" class="form-control" autocomplete="tel" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Role" class="form-label"></label>
                <select asp-for="Role" class="form-select" id="roleSelect">
                    <option value="Participant">Participant (enter events)</option>
                    <option value="Organiser">Organiser (manage events)</option>
                </select>
                <span asp-validation-for="Role" class="text-danger"></span>
            </div>

            <div class="mb-3" id="codeGroup" style="display:none;">
                <label asp-for="OrganiserCode" class="form-label"></label>
                <input asp-for="OrganiserCode" class="form-control" autocomplete="off" />
                <div class="form-text">Ask the RaceDay administrator for the invite code.</div>
                <span asp-validation-for="OrganiserCode" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                <div class="form-text">At least 8 characters.</div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">Create account</button>
        </form>

        <p class="mt-3 text-center">
            Already registered? <a asp-action="Login">Log in</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Show the invite code box only when "Organiser" is chosen.
        const roleSelect = document.getElementById('roleSelect');
        const codeGroup = document.getElementById('codeGroup');
        function toggleCode() {
            codeGroup.style.display = roleSelect.value === 'Organiser' ? 'block' : 'none';
        }
        roleSelect.addEventListener('change', toggleCode);
        toggleCode();
    </script>
}
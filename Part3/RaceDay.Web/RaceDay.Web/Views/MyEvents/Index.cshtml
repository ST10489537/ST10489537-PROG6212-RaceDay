@model List<EnrolmentDto>
@{
    ViewData["Title"] = "My events";
}

<h1 class="h3 mb-3">My events</h1>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">
        You have not entered any events yet.
        <a asp-controller="Home" asp-action="Index">Browse upcoming events</a>.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Event</th>
                    <th>Event date</th>
                    <th>Category</th>
                    <th>Enrolled on</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model)
                {
                    <tr>
                        <td>@e.EventName</td>
                        <td>@e.EventDate.ToString("dd MMM yyyy HH:mm")</td>
                        <td>@e.CategoryName</td>
                        <td>@e.EnrolmentDate.ToString("dd MMM yyyy")</td>
                        <td><partial name="_StatusBadge" model="e.Status" /></td>
                        <td class="text-end">
                            <a asp-controller="EventDetails" asp-action="Index" asp-route-id="@e.EventID"
                               class="btn btn-sm btn-outline-primary">View event</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}